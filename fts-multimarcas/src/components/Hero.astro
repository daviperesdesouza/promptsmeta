---
import { getImage } from 'astro:assets';
import { CONFIG, TEXTOS, wa, foto } from '../lib/conteudo';

// Foto com recorte próprio por tamanho de tela (desktop vertical, celular horizontal).
const desk = foto(CONFIG.fotos.hero.desktop);
const mob = foto(CONFIG.fotos.hero.mobile);
const fontes = async (src: typeof desk, widths: number[]) => ({
  avif: (await getImage({ src, widths, format: 'avif', quality: 60 })).srcSet.attribute,
  webp: (await getImage({ src, widths, format: 'webp', quality: 74 })).srcSet.attribute,
});
const d = await fontes(desk, [520, 720, 965]);
const m = await fontes(mob, [480, 780, 1100]);
const fallback = await getImage({ src: mob, width: 780, format: 'webp', quality: 74 });
const anos = CONFIG.numeros.find(n => n.unidade === 'anos' && n.confirmado);
const carros = CONFIG.numeros.find(n => n.destaque && n.confirmado);
// Título separado em palavras já no build: a abertura roda só com CSS, sem esperar o JS.
const palavras = (t: string, k0 = 0) => t.split(/\s+/).filter(Boolean).map((p, i) => ({ p, k: k0 + i }));
const p1 = palavras(TEXTOS.hero.titulo), p2 = palavras(TEXTOS.hero.tituloDestaque, p1.length);
---
<section class="hero" aria-labelledby="h1">
  <div class="hero-foto">
    <picture>
      <source media="(min-width: 1024px)" type="image/avif" srcset={d.avif} sizes="(min-width: 1360px) 620px, 46vw">
      <source media="(min-width: 1024px)" type="image/webp" srcset={d.webp} sizes="(min-width: 1360px) 620px, 46vw">
      <source type="image/avif" srcset={m.avif} sizes="100vw">
      <source type="image/webp" srcset={m.webp} sizes="100vw">
      <img src={fallback.src} alt={CONFIG.fotos.hero.alt} width="1254" height="940" fetchpriority="high" decoding="async">
    </picture>
    <p class="hero-etiqueta"><span class="ponto" aria-hidden="true"></span>Fabricio Teixeira · consultor 0 km</p>
  </div>

  <div class="hero-texto">
    <p class="rotulo hero-entra" style="--d:.15s">{TEXTOS.hero.eyebrow}</p>
    <h1 id="h1" class="tit tit--abertura">
      <span class="sr">{TEXTOS.hero.titulo} {TEXTOS.hero.tituloDestaque}</span>
      <span aria-hidden="true">{p1.map(w => <><span class="w"><span class="wi" style={`--k:${w.k}`}>{w.p}</span></span>{' '}</>)}<span class="verde-tx">{p2.map((w, i) => <>{i > 0 && ' '}<span class="w"><span class="wi" style={`--k:${w.k}`}>{w.p}</span></span></>)}</span></span>
    </h1>
    <p class="hero-sub hero-entra" style="--d:.45s">{TEXTOS.hero.sub}</p>
    <div class="hero-acoes hero-entra" style="--d:.55s">
      <a class="btn" data-wa="encontrar" data-cta href={wa('encontrar')} target="_blank" rel="noopener">
        <svg aria-hidden="true"><use href="#i-wa" /></svg>Quero encontrar meu próximo carro
      </a>
      <a class="link-seta" data-wa="condicoes" data-cta href={wa('condicoes')} target="_blank" rel="noopener">Quero saber as condições</a>
    </div>
    <ul class="hero-prova hero-entra" style="--d:.65s" aria-label="Em resumo">
      {carros && <li><b class="num">+{carros.valor.toLocaleString('pt-BR')}</b><span>carros entregues</span></li>}
      {anos && <li><b class="num">+{anos.valor}</b><span>anos de atuação</span></li>}
      <li><b class="num">14</b><span>marcas, um consultor</span></li>
    </ul>
  </div>
</section>

<style>
  /* Grade "quebrada": no desktop a foto ocupa da coluna do meio até a borda da tela. */
  .hero {
    --lado: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    display: grid; grid-template-columns: var(--lado) minmax(0, 1fr) var(--lado);
    row-gap: 26px; padding-bottom: clamp(56px, 7vw, 104px);
  }
  .hero-foto { grid-column: 1 / -1; position: relative; height: clamp(240px, 37svh, 460px); overflow: hidden; }
  .hero-foto picture, .hero-foto img { width: 100%; height: 100%; }
  .hero-foto img { object-fit: cover; object-position: 50% 32%; }
  .hero-foto::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(16,16,16,0) 62%, rgba(16,16,16,.22)); }
  .hero-etiqueta { position: absolute; z-index: 2; left: var(--lado); bottom: 14px; display: inline-flex; align-items: center; gap: 9px; padding: 9px 14px; border-radius: 999px; background: var(--branco); color: var(--preto); font: 600 .8125rem/1 var(--f-texto); box-shadow: var(--sombra-flutua); }
  .ponto { width: 8px; height: 8px; border-radius: 50%; background: var(--verde); box-shadow: 0 0 0 4px var(--verde-100); }
  .hero-texto { grid-column: 2; }
  .rotulo { margin-bottom: 16px; }
  h1 { font-size: var(--t-hero); line-height: .94; letter-spacing: -.035em; font-stretch: 100%; }
  .hero-sub { margin-top: 18px; font-size: var(--t-lead); line-height: 1.48; color: var(--tinta-2); max-width: 40ch; }
  .hero-acoes { margin-top: 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; }
  .hero-prova { margin-top: 30px; display: none; gap: 0; border-top: 1px solid var(--linha); padding-top: 18px; }
  .hero-prova li { display: grid; gap: 4px; padding-right: 26px; margin-right: 26px; border-right: 1px solid var(--linha); }
  .hero-prova li:last-child { border-right: 0; }
  .hero-prova b { font-size: 1.45rem; font-weight: 800; line-height: 1; letter-spacing: -.02em; }
  .hero-prova span { font-size: .8125rem; color: var(--tinta-2); }
  @media (max-width: 420px) { .hero-acoes .btn { width: 100%; } .hero-acoes .link-seta { display: none; } }
  @media (min-width: 640px) { .hero-prova { display: flex; } }
  @media (min-width: 640px) and (max-width: 1023px) { .hero-foto { margin-inline: var(--lado); border-radius: var(--r-foto); } .hero-etiqueta { left: 16px; } }
  @media (min-width: 1024px) {
    .hero { grid-template-columns: var(--lado) minmax(0, 1.12fr) minmax(0, .88fr); column-gap: clamp(28px, 4vw, 64px); align-items: center; min-height: min(calc(100svh - var(--header-h)), 860px); padding-block: 12px clamp(40px, 5vw, 72px); }
    .hero-texto { grid-column: 2; grid-row: 1; }
    .hero-foto { grid-column: 3; grid-row: 1; align-self: stretch; height: auto; min-height: 560px; max-height: 820px; border-radius: 0 0 0 calc(var(--r-foto) + 10px); }
    .hero-foto img { object-position: 50% 30%; }
    .hero-etiqueta { left: 22px; bottom: 22px; }
  }

  /* Abertura em CSS puro, a partir da primeira pintura (não espera o JS). Tudo em < 1,2 s. */
  @keyframes hero-foto { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes hero-zoom { from { transform: scale(1.1); } }
  @keyframes hero-sobe { from { opacity: 0; transform: translateY(14px); } }
  :global(.mov:not(.reduz)) .hero-foto { animation: hero-foto 1s var(--e-meio) .1s both; }
  :global(.mov:not(.reduz)) .hero-foto img { animation: hero-zoom 1.1s var(--e-saida) .1s both; }
  :global(.mov:not(.reduz)) .hero-etiqueta { animation: hero-sobe .5s var(--e-saida) .8s both; }
  :global(.mov:not(.reduz)) .hero-entra { animation: hero-sobe .65s var(--e-saida) var(--d, .4s) both; }
</style>
