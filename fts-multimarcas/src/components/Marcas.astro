---
import { getImage } from 'astro:assets';
import { CONFIG, logosDa } from '../lib/conteudo';

const parede = await Promise.all(CONFIG.marcas.map(async marca => ({
  marca,
  logos: await Promise.all(logosDa(marca).map(async l => {
    const g = await getImage({ src: l.img, width: 260, format: 'webp', quality: 84 });
    return { src: g.src, w: g.attributes.width, h: g.attributes.height };
  })),
})));
const [base, ...outras] = CONFIG.cidades;
---
<section class="secao mr" id="marcas" aria-labelledby="t-marcas">
  <div class="wrap grade">
    <div class="mr-marcas">
      <p class="rotulo rv">Marcas</p>
      <h2 id="t-marcas" class="h2 tit">14 marcas numa conversa.</h2>
      <ul class="parede" aria-label="Marcas atendidas">
        {parede.map((m, i) => (
          <li class:list={['tile', 'rv', { 'tile--duplo': m.logos.length > 1 }]} style={`--rd:${(i % 5) * 0.05}s`}>
            {m.logos.length ? m.logos.map(l => <img src={l.src} alt="" width={l.w} height={l.h} loading="lazy" decoding="async" />) : <span>{m.marca}</span>}
            <span class="sr">{m.marca.replace(' | ', ' e ')}</span>
          </li>
        ))}
        <li class="tile tile--extra rv" style="--rd:.2s">+ alguns<br>seminovos</li>
      </ul>
      <p class="mr-nota">Consultor independente, em parceria com as marcas. Os logos pertencem às respectivas montadoras.</p>
    </div>

    <div class="mr-regiao">
      <p class="rotulo rv">Onde eu atendo</p>
      <h2 class="regiao-tit tit">E eu vou até você.</h2>
      <ul class="placas" aria-label="Cidades atendidas">
        <li class="placa placa--base rv"><svg aria-hidden="true"><use href="#i-pino" /></svg><span class="placa-cidade">{base}</span><span class="placa-tag">Base</span></li>
        {outras.map((c, i) => <li class="placa rv" style={`--rd:${(i + 1) * 0.06}s`}><span class="placa-cidade">{c}</span></li>)}
        <li class="placa placa--entorno rv" style="--rd:.42s"><span class="placa-cidade">e entorno</span></li>
      </ul>
      <p class="mr-nota">Espírito Santo. No dia da entrega, eu te busco e te levo até a concessionária da marca.</p>
    </div>
  </div>
</section>

<style>
  .mr .grade { row-gap: 72px; }
  .mr-marcas, .mr-regiao { grid-column: 1 / -1; min-width: 0; }
  .mr .rotulo { margin-bottom: 14px; }
  .parede { margin-top: 30px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--linha); border: 1px solid var(--linha); border-radius: var(--r-card); overflow: hidden; }
  .tile { display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 96px; padding: 16px 12px; background: #fff; position: relative; transition: transform .35s var(--e-saida), box-shadow .35s var(--e-saida); }
  .tile:hover { transform: translateY(-3px); box-shadow: 0 16px 30px -18px rgba(16, 16, 16, .4); z-index: 1; }
  .tile img { width: auto; height: auto; max-height: 50px; max-width: min(118px, 100%); object-fit: contain; }
  .tile--duplo { flex-direction: column; gap: 6px; }
  .tile--duplo img { max-height: 18px; }
  .tile--extra { background: var(--verde); color: var(--branco); font: 700 .95rem/1.2 var(--f-display); text-align: center; }
  .tile--extra:hover { transform: none; box-shadow: none; }
  .mr-nota { margin-top: 14px; font-size: .8125rem; color: var(--tinta-2); max-width: 46ch; }
  .regiao-tit { font-size: clamp(1.9rem, 1.2rem + 2.6vw, 3.2rem); margin-bottom: 26px; }

  /* Placas de destino (como as verdes de estrada): borda branca interna, letra estreita. */
  /* Sem setas: as placas informam, não são links. */
  .placas { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }

  .placa { display: inline-flex; align-items: center; gap: 14px; min-height: 58px; padding: 10px 18px 10px 20px; background: var(--verde); color: var(--branco); border-radius: 9px; outline: 2px solid var(--branco); outline-offset: -6px; box-shadow: 0 10px 22px -16px rgba(4, 64, 26, .8); font: 700 clamp(1.25rem, 1rem + 1vw, 1.75rem)/1 var(--f-display); font-stretch: 86%; letter-spacing: .01em; }
  .placa svg { width: 22px; height: 22px; flex: none; }
  .placa-tag { font: 700 .62rem/1 var(--f-display); font-stretch: 125%; letter-spacing: .16em; text-transform: uppercase; padding: 5px 7px; border-radius: 4px; background: var(--branco); color: var(--verde-600); }
  .placa--base { flex: 1 1 100%; max-width: 440px; font-size: clamp(1.55rem, 1.15rem + 1.6vw, 2.35rem); min-height: 72px; }
  .placa--base .placa-tag { margin-left: auto; }
  .placa--entorno { background: transparent; color: var(--tinta-2); outline: 2px dashed var(--linha); outline-offset: -2px; box-shadow: none; }
  @media (min-width: 640px) { .parede { grid-template-columns: repeat(5, 1fr); } }
  @media (min-width: 1024px) {
    .mr-marcas { grid-column: 1 / 8; }
    .mr-regiao { grid-column: 9 / -1; }
  }
</style>
