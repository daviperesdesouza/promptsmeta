---
import { getImage } from 'astro:assets';
import { CONFIG, wa, foto, revisao, servicoVisivel, servicoPendente } from '../lib/conteudo';

type Card = { nome: string; cat: string; rotulo: string; fotoTipo?: string; intencao: 'encontrar' | 'frota'; classe: string };
const cards: Card[] = [
  { nome: 'SUV', cat: 'SUV', rotulo: 'Falar sobre SUV', fotoTipo: 'SUV', intencao: 'encontrar', classe: 'c-suv' },
  { nome: 'Picape', cat: 'Picape', rotulo: 'Falar sobre picape', fotoTipo: 'Picape', intencao: 'encontrar', classe: 'c-picape' },
  { nome: 'Hatch', cat: 'Hatch', rotulo: 'Falar sobre hatch', fotoTipo: 'Hatch', intencao: 'encontrar', classe: 'c-hatch' },
  { nome: 'Elétrico ou híbrido', cat: 'Elétrico/Híbrido', rotulo: 'Falar sobre elétricos', fotoTipo: 'Elétrico', intencao: 'encontrar', classe: 'c-eletrico' },
  { nome: 'Sedã', cat: 'Sedã', rotulo: 'Falar sobre sedã', intencao: 'encontrar', classe: 'c-seda' },
];
const fotoDe = (t?: string) => (t && CONFIG.fotoPorTipo[t]) ? foto(CONFIG.fotoPorTipo[t]) : null;

// No celular o cartão é em pé (5:6): recorte próprio, menor e centrado no que chama atenção (pessoas).
// Do tablet para cima, a foto inteira em paisagem.
const imagens = await Promise.all(cards.map(async c => {
  const src = fotoDe(c.fotoTipo);
  if (!src) return null;
  const pe = { src, widths: [320, 480, 640], width: 640, height: 768, fit: 'cover' as const, position: 'attention' };
  const deitada = { src, widths: [560, 800, 1040] };
  const [mAvif, mWebp, dAvif, dWebp, fb] = await Promise.all([
    getImage({ ...pe, format: 'avif', quality: 52 }),
    getImage({ ...pe, format: 'webp', quality: 70 }),
    getImage({ ...deitada, format: 'avif', quality: 56 }),
    getImage({ ...deitada, format: 'webp', quality: 72 }),
    getImage({ src, width: 800, format: 'webp', quality: 72 }),
  ]);
  return { mAvif: mAvif.srcSet.attribute, mWebp: mWebp.srcSet.attribute, dAvif: dAvif.srcSet.attribute, dWebp: dWebp.srcSet.attribute, src: fb.src, w: fb.attributes.width, h: fb.attributes.height };
}));
---
<section class="secao cats" id="procura" aria-labelledby="t-procura">
  <div class="wrap">
    <div class="cats-topo">
      <div>
        <p class="rotulo rv">Comece por aqui</p>
        <h2 id="t-procura" class="h2 tit">O que você procura?</h2>
      </div>
      <p class="lead rv" style="--rd:.1s">Toque no tipo de carro. O WhatsApp abre com a mensagem pronta. É só enviar.</p>
    </div>
    <ul class="mosaico">
      {cards.map((c, i) => {
        const img = imagens[i];
        return (
          <li class:list={[c.classe, 'rv']} style={`--rd:${i * 0.06}s`}>
            <a class:list={['cat', { 'cat--foto': img, 'cat--tipo': !img }]} data-wa={c.intencao} data-cat={c.cat} href={wa(c.intencao, c.cat)} target="_blank" rel="noopener">
              {img && (
                <picture>
                  <source media="(max-width: 639px)" type="image/avif" srcset={img.mAvif} sizes="300px" />
                  <source media="(max-width: 639px)" type="image/webp" srcset={img.mWebp} sizes="300px" />
                  <source type="image/avif" srcset={img.dAvif} sizes="(min-width: 1024px) 40vw, 48vw" />
                  <source type="image/webp" srcset={img.dWebp} sizes="(min-width: 1024px) 40vw, 48vw" />
                  <img class="cat-img" src={img.src} alt="" width={img.w} height={img.h} loading="lazy" decoding="async" />
                </picture>
              )}
              <span class="cat-nome">{c.nome}</span>
              <span class="cat-acao">{c.rotulo}<span class="cat-seta" aria-hidden="true"><svg><use href="#i-seta" /></svg></span></span>
            </a>
          </li>
        );
      })}
      {servicoVisivel('frotas') && (
        <li class="c-empresas rv" style="--rd:.3s">
          <a class="cat cat--empresas" data-wa="frota" data-cat="Empresas" href={wa('frota')} target="_blank" rel="noopener">
            <span class="cat-nome">Empresas e frotas</span>
            <span class="cat-desc">Carro para CNPJ, frota, locadora, autoescola e taxista.</span>
            <span class="cat-acao">Falar sobre minha frota<span class="cat-seta" aria-hidden="true"><svg><use href="#i-seta" /></svg></span></span>
            {revisao && servicoPendente('frotas') && <span class="pend">[PENDENTE: confirmar]</span>}
          </a>
        </li>
      )}
    </ul>
    <p class="cats-dica rv">Ainda não sabe? <a class="link-seta" data-wa="encontrar" data-sem-cat href={wa('encontrar')} target="_blank" rel="noopener">Me conta o seu uso</a></p>
  </div>
</section>

<style>
  .cats-topo { display: grid; gap: 18px; margin-bottom: clamp(28px, 4vw, 52px); }
  .cats-topo .rotulo { margin-bottom: 14px; }
  @media (min-width: 900px) { .cats-topo { grid-template-columns: 1.2fr .8fr; align-items: end; } .cats-topo .lead { justify-self: end; } }

  /* Celular: lista deslizável. */
  .mosaico { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px var(--gutter) 18px; margin-inline: calc(var(--gutter) * -1); scrollbar-width: none; overscroll-behavior-x: contain; scroll-padding-inline: var(--gutter); }
  .mosaico::-webkit-scrollbar { display: none; }
  /* Na faixa deslizável os cartões já ficam prontos: revelar ao arrastar parece falha. */
  @media (max-width: 639px) { :global(.mov) .mosaico > li { opacity: 1; transform: none; transition: none; } }
  .mosaico > li { flex: 0 0 min(74vw, 300px); scroll-snap-align: start; }
  .c-empresas { flex-basis: min(86vw, 360px) !important; }

  .cat { position: relative; container-type: inline-size; display: flex; flex-direction: column; justify-content: flex-end; gap: 12px; height: 100%; min-height: 360px; padding: 20px; border-radius: var(--r-card); overflow: hidden; isolation: isolate; text-decoration: none; color: var(--branco); background: var(--preto); transition: transform .4s var(--e-saida); -webkit-tap-highlight-color: transparent; }
  .cat:active { transform: scale(.985); }
  .cat :global(.cat-img) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--e-saida); }
  .cat--foto::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(16,16,16,0) 35%, rgba(16,16,16,.82)); transition: background .5s; }
  .cat--foto:hover :global(.cat-img), .cat--foto:focus-visible :global(.cat-img) { transform: scale(1.06); }
  .cat--foto:hover::before { background: linear-gradient(180deg, rgba(4,132,55,.05) 25%, rgba(3,60,26,.9)); }
  .cat-nome { font: 800 clamp(1.75rem, 10.5cqi, 2.9rem)/.95 var(--f-display); letter-spacing: -.03em; max-width: 9ch; text-wrap: balance; }
  .c-eletrico .cat-nome { max-width: none; font-size: clamp(1.6rem, 8.2cqi, 2.5rem); }
  .c-eletrico :global(.cat-img) { object-position: 50% 24%; }
  .cat-acao { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-weight: 600; font-size: var(--t-peq); }
  .cat-seta { flex: none; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--branco); color: var(--preto); transition: transform .45s var(--e-saida), background .3s, color .3s; }
  .cat-seta svg { width: 18px; height: 18px; }
  .cat:hover .cat-seta, .cat:focus-visible .cat-seta { transform: rotate(-45deg); background: var(--verde); color: var(--branco); }
  /* Sem foto de entrega de sedã: o cartão vira um trecho de asfalto com a faixa central. */
  .cat--tipo { background: radial-gradient(120% 90% at 85% 0%, #262926, var(--asfalto-2) 60%); }
  .cat--tipo::before, .cat--tipo::after { content: ""; position: absolute; left: 0; right: 0; z-index: -1; }
  .cat--tipo::before { top: 18px; height: 2px; background: rgba(255, 255, 255, .22); }
  .cat--tipo::after { top: 44%; height: 3px; background: repeating-linear-gradient(90deg, rgba(255, 255, 255, .7) 0 22px, transparent 22px 44px); transition: background-position 1.2s var(--e-saida); }
  .cat--tipo:hover::after { background-position: 88px 0; }
  .cat--empresas { background: var(--verde); }
  .cat--empresas .cat-nome { max-width: 12ch; }
  .cat-desc { color: var(--branco); font-size: var(--t-peq); max-width: 30ch; }
  .cat--empresas .cat-seta { background: var(--branco); color: var(--preto); }
  .cat--empresas:hover .cat-seta { background: var(--preto); color: var(--branco); }
  .cat .pend { position: absolute; top: 14px; left: 14px; }
  @media (prefers-reduced-motion: reduce) {
    .cat, .cat :global(.cat-img), .cat-seta, .cat--tipo::after { transition: none; }
    .cat--foto:hover :global(.cat-img), .cat--foto:focus-visible :global(.cat-img) { transform: none; }
  }
  .cats-dica { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; color: var(--tinta-2); }

  @media (min-width: 640px) {
    .mosaico { display: grid; grid-template-columns: repeat(2, 1fr); overflow: visible; margin: 0; padding: 0; gap: var(--gap); }
    .mosaico > li { flex: auto; }
    .c-empresas { grid-column: 1 / -1; }
    .cat { min-height: 300px; }
    .c-suv .cat { min-height: 420px; }
  }
  @media (min-width: 1024px) {
    .mosaico { grid-template-columns: repeat(12, 1fr); grid-auto-rows: minmax(240px, auto); }
    .c-suv { grid-column: 1 / 6; grid-row: 1 / 3; }
    .c-picape { grid-column: 6 / 10; grid-row: 1; }
    .c-hatch { grid-column: 10 / 13; grid-row: 1; }
    .c-eletrico { grid-column: 6 / 10; grid-row: 2; }
    .c-seda { grid-column: 10 / 13; grid-row: 2; }
    .c-empresas { grid-column: 1 / 13; grid-row: 3; }
    .cat { min-height: 0; }
    .c-suv .cat { min-height: 0; }
    .cat--empresas { flex-direction: row; align-items: flex-end; justify-content: space-between; min-height: 180px; padding: 26px 28px; }
    .cat--empresas .cat-acao { flex: none; gap: 16px; }
  }
</style>
